GEMINI_API_KEY=
TYPESAFE_API_KEY=

# Hard spending guard for Gemini (total across all runs, ledger in out/gemini_ledger.json)
GEMINI_BUDGET_USD=10
GEMINI_MAX_VIDEO_MINUTES=40

# Sample episodes are streamed from Cloudflare R2 (public bucket URL, e.g. https://pub-xxxx.r2.dev)
R2_PUBLIC_BASE_URL=
# Only needed on your machine to upload the samples (scripts/upload_r2.py)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Optional
# GEMINI_MODEL=gemini-3.8-flash
# JEV_MODEL=jev-latest
# CREATIVE_BASE_URL=https://cdn.example.com/   # prefix for catalogue creative urls in the VMAP (default "/")
# UNSAFE_SLOT_POLICY=move                      # move | house_promo, when no catalogue brand is safe at a break
